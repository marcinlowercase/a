{
  "manifest_version": 2,
  "name": "outsync core extension",
  "version": "1.2",
  "description": "outsync bridge and design token injector for the browser of oo1 studio",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser_core_extension@marcinlowercase",
      "strict_min_version": "57.0"
    }
  },
  "permissions": [
    "<all_urls>",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["outsync_theme.js", "outsync_logic.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["favicon_fetcher.js"],
      "run_at": "document_idle"
    }
  ]
}